{
  "$schema": "https://stryker-mutator.io/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": [
    "typescript"
  ],
  "tsconfigFile": "tsconfig.app.json",
  "mutate": [
    "src/services/**/*.ts",
    "src/utils/**/*.ts",
    "!src/**/__tests__/**",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/*.spec.tsx",
    "!src/services/api.ts",
    "!src/services/index.ts"
  ],
  "coverageAnalysis": "off",
  "reporters": [
    "clear-text",
    "progress",
    "html"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "thresholds": {
    "high": 75,
    "low": 60,
    "break": 50
  },
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "tempDirName": ".stryker-tmp"
}
